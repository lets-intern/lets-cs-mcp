  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.23",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
