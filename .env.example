# 이 MCP 서버를 부르는 쪽(Claude)이 Authorization: Bearer <값> 으로 보내는 키. 대시보드 세션 서명에도 쓴다.
# 만들기: openssl rand -hex 32
MCP_AUTH_TOKEN=
# 대시보드 로그인 비밀번호
DASHBOARD_PASSWORD=
# 렛츠커리어 API 와 서비스용 어드민 계정
LETS_API_BASE=
LETS_ADMIN_EMAIL=
LETS_ADMIN_PASSWORD=
# 비우면 로컬 파일 local.db 를 쓴다. 배포에서는 Turso 원본 DB 의 주소와 토큰을 넣는다.
# Vercel Turso 연동이 배포마다 브랜치 DB 를 만들어 TURSO_* 를 바꾸므로, 원본 DB 를 고정하려면 CS_DB_* 를 쓴다.
CS_DB_URL=
CS_DB_TOKEN=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
